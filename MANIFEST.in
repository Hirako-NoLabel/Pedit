include README.md LICENSE THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md ROADMAP.md
include .gitignore pyproject.toml
recursive-include src *.py *.html *.css *.js
recursive-include tests *.py *.cjs *.md
recursive-include docs *.md
recursive-include scripts *.py
recursive-include .github *.yml *.md
global-exclude *.py[cod] __pycache__ .DS_Store
